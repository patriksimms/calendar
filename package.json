{
  "name": "rc-calendar",
  "version": "9.15.10",
  "description": "React Calendar",
  "keywords": [
    "react",
    "react-calendar",
    "react-component",
    "calendar",
    "ui component",
    "ui",
    "component"
  ],
  "files": [
    "lib",
    "es",
    "assets",
    "index.d.ts"
  ],
  "main": "lib/index",
  "module": "es/index",
  "homepage": "http://github.com/react-component/calendar",
  "author": "yiminghe@gmail.com",
  "repository": {
    "type": "git",
    "url": "git@github.com:react-component/calendar.git"
  },
  "bugs": {
    "url": "http://github.com/react-component/calendar/issues"
  },
  "licenses": "MIT",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "tsdown && lessc assets/index.less assets/index.css",
    "build:js": "tsdown",
    "build:css": "lessc assets/index.less assets/index.css",
    "prepublishOnly": "bun run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "test": "vitest --run",
    "test:jest": "jest",
    "typecheck": "tsc --noEmit",
    "types": "tsc --noEmit",
    "coverage": "jest --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "testURL": "http://localhost"
  },
  "peerDependencies": {
    "react": ">=16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": ">=16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^16.3.13",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "enzyme-to-json": "^3.3.1",
    "jest": "^22.1.4",
    "less": "^4.0.0",
    "mockdate": "^2.0.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "rc-dialog": "^7.0.0",
    "rc-select": "^9.1.5",
    "rc-time-picker": "^3.1.0",
    "react": "^16.5.2",
    "react-dom": "^16.5.2",
    "tsdown": "^0.21.10",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "classnames": "2.x",
    "moment": "2.x",
    "prop-types": "^15.5.8",
    "rc-trigger": "^2.2.0",
    "rc-util": "^4.1.1",
    "react-lifecycles-compat": "^3.0.4"
  },
  "types": "index.d.ts"
}
